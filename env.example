# ==============================================================================
# ENTERPRISE ACCESS CONTROL ARCHITECTURE - ENVIRONMENT TEMPLATE
# Copy this file to '.env' and update values for your runtime environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 18 Engine)
# ------------------------------------------------------------------------------
POSTGRES_USER=app_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_HOST=db                                    # Use 'db' for Docker Compose, '127.0.0.1' for local host
POSTGRES_PORT=5432
POSTGRES_DB=access_control_db
DATABASE_URL=postgresql://app_user:your_secure_db_password_here@db:5432/access_control_db

# ------------------------------------------------------------------------------
# JWT & Identity Provider Security Configuration
# ------------------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=jwt_public.pem                  # Path to RSA public key for verification
JWT_PRIVATE_KEY_PATH=jwt_private.pem                # Path to RSA private key (Token generation/signing)
ISSUER=http://127.0.0.1:7010                         # Expected token issuer ('iss' claim boundary)
AUDIENCE=http://127.0.0.1:7010                       # Expected token audience ('aud' claim boundary)
JWKS_URL=http://127.0.0.1:7010/.well-known/jwks.json # Remote JWKS endpoint (Used when integrating remote IdP)

# ------------------------------------------------------------------------------
# CORS Origin Authorization Policy
# ------------------------------------------------------------------------------

# Comma-separated array of trusted frontend application domains allowed to make cross-origin requests.
# Add new client production web app URLs to the end of this list.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://newclientapp.com,https://example.com
